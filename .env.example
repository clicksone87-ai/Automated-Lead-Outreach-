# ─── Runtime ──────────────────────────────────────────────────────────────
APP_MODE=local
LOG_LEVEL=INFO
# true = integrations without keys use fixture mocks (demo/dev). Mock output is never sent.
DEMO_MODE=true
DATABASE_URL=postgresql+psycopg://leads:leads@postgres:5432/leads
REDIS_URL=redis://redis:6379/0
# Host port for Postgres (change if something else on your machine uses 5432)
POSTGRES_PORT=5432
DATA_DIR=/data
DASHBOARD_ORIGIN=http://localhost:3000

# ─── OpenAI (Requirements, Audit vision, Branding, Proposal) ─────────────
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_VISION_MODEL=
OPENAI_IMAGE_MODEL=

# ─── Search / Google ─────────────────────────────────────────────────────
BRAVE_SEARCH_API_KEY=
GOOGLE_PAGESPEED_API_KEY=
GOOGLE_PLACES_API_KEY=

# ─── Email sending (Resend) + sender identity ────────────────────────────
RESEND_API_KEY=
SENDING_DOMAIN=
SENDER_NAME=
SENDER_BUSINESS_NAME=
SENDER_POSTAL_ADDRESS=
PORTFOLIO_URL=

# ─── Reply mailbox (IMAP) ────────────────────────────────────────────────
REPLY_IMAP_HOST=
REPLY_IMAP_USER=
REPLY_IMAP_PASSWORD=
# Folder in the same mailbox that receives job-board / classifieds alert emails
ALERTS_IMAP_FOLDER=Alerts

# ─── Email verification ──────────────────────────────────────────────────
EMAIL_VERIFICATION_PROVIDER=zerobounce
EMAIL_VERIFICATION_API_KEY=

# ─── Platform sources ────────────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
X_BEARER_TOKEN=
META_ACCESS_TOKEN=
FREELANCER_API_TOKEN=
PRODUCTHUNT_API_TOKEN=

# ─── Business registries ─────────────────────────────────────────────────
OPENCORPORATES_API_KEY=
COMPANIES_HOUSE_API_KEY=

# ─── Public URLs (leave empty in local mode) ─────────────────────────────
PUBLIC_PREVIEW_BASE_URL=
PUBLIC_API_BASE_URL=

# ─── Limits (initial values; live values are edited in the dashboard) ────
MONTHLY_BUDGET_USD=120
DAILY_BUDGET_USD=4
MIN_INTENT_SCORE=60
COOLDOWN_DAYS=90
DAILY_SEND_LIMIT=10
AUTONOMY_STAGE=1
MAX_JOB_ATTEMPTS=4
