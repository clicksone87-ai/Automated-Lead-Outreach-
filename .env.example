# Copy to .env and fill in. Every variable maps 1:1 to a field in backend/app/config.py.
# NEVER commit .env. A missing key disables that integration gracefully (shown on the
# Sources page) — the system never falls back to mock data.

# ─── Runtime ──────────────────────────────────────────────────────────────
APP_MODE=local
# free = testing mode on free-tier providers only (paid integrations forced off) | paid
APP_TIER=free
LOG_LEVEL=INFO
# Mock adapters are honoured ONLY by the automated test suite (APP_MODE=test). Keep false.
DEMO_MODE=false
DATABASE_URL=postgresql+psycopg://leads:leads@postgres:5432/leads
REDIS_URL=redis://redis:6379/0
# Host port for Postgres (change if something else on your machine uses 5432)
POSTGRES_PORT=5432
DATA_DIR=/data
# Website templates (read-only mount in the containers)
SITE_TEMPLATES_DIR=/site-templates
EMAIL_TEMPLATES_DIR=/email-templates
# Template dependencies + compiled bundles (empty = DATA_DIR/site-builder; compose uses a volume)
SITE_BUILDER_DIR=
# Signs unsubscribe links. Empty = a local per-installation fallback; set a long random value on a server.
APP_SECRET=
DASHBOARD_ORIGIN=http://localhost:3000
# Optional bearer token for the API (recommended when moving to a server). Empty = off.
API_TOKEN=
CRAWLER_USER_AGENT=LeadsSystemBot/0.1 (+contact via sender website; respects robots.txt)

# ─── Provider selection ──────────────────────────────────────────────────
LLM_PROVIDER=gemini
# serper (falls back to exa) | exa | brave (paid; off in testing mode)
SEARCH_PROVIDER=serper
# smtp (Mailpit in testing: nothing is really sent) | resend (go-live)
EMAIL_PROVIDER=smtp

# ─── Gemini (free tier; text, structured output, vision, SVG logo concepts) ──
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
GEMINI_LOGO_MODEL=gemini-3.5-flash
# tried in order when the main model is overloaded (503) or times out
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.8-flash
GEMINI_RPM=10
GEMINI_DAILY_REQUEST_CAP=500

# ─── OpenAI (kept for go-live, inactive; off in testing mode) ─────────────
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_VISION_MODEL=
OPENAI_IMAGE_MODEL=

# ─── Search: Serper (Google results via API) + Exa (fallback) ──────────────
SERPER_API_KEY=
SERPER_FREE_CREDITS=2500
# One-time credits: daily ceiling so they last (60/day ≈ one month)
SERPER_DAILY_CAP=60
EXA_API_KEY=
EXA_FREE_CREDIT_USD=10
# Paid; off in testing mode
BRAVE_SEARCH_API_KEY=

# ─── Apify (licensed provider for public posts: Facebook and Instagram only; one token) ──
APIFY_API_TOKEN=
APIFY_MONTHLY_CAP_USD=5

# ─── Scout profiles (optional, free official APIs) ──────────────────────
# Twitch profiles: create an app at https://dev.twitch.tv/console (without keys: search snippet only)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# GitHub profiles: works without a token (60 lookups/hour); a token raises the limit
GITHUB_TOKEN=

# ─── Google ──────────────────────────────────────────────────────────────
GOOGLE_PAGESPEED_API_KEY=
PAGESPEED_DAILY_CAP=400
# Paid; off in testing mode (single-business lookups use Serper local results instead)
GOOGLE_PLACES_API_KEY=

# ─── Email: SMTP → Mailpit (testing) ─────────────────────────────────────
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAILPIT_API_URL=http://mailpit:8025

# ─── Email: Resend + IMAP (go-live; off in testing mode) ─────────────────
RESEND_API_KEY=
SENDING_DOMAIN=
REPLY_IMAP_HOST=
REPLY_IMAP_USER=
REPLY_IMAP_PASSWORD=

# ─── Sender identity (every email carries it) ────────────────────────────
SENDER_NAME=
SENDER_BUSINESS_NAME=
SENDER_POSTAL_ADDRESS=
PORTFOLIO_URL=

# ─── Email verification: local (syntax + MX, free) | zerobounce (paid) ───
EMAIL_VERIFICATION_PROVIDER=local
EMAIL_VERIFICATION_API_KEY=

# ─── Official platform APIs (kept, disabled; off in testing mode) ────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
X_BEARER_TOKEN=
META_ACCESS_TOKEN=

# ─── Registries ──────────────────────────────────────────────────────────
COMPANIES_HOUSE_API_KEY=
# Paid licence; off in testing mode
OPENCORPORATES_API_KEY=

# ─── Public URLs (tunnel or deployment; empty = local mode attachments) ──
PUBLIC_PREVIEW_BASE_URL=
PUBLIC_API_BASE_URL=

# ─── Limits (seeded into the settings table; edit later in the dashboard) ─
# 0 = no paid call may ever run; free tiers are tracked against each provider's own cap
MONTHLY_BUDGET_USD=0
DAILY_BUDGET_USD=0
MIN_INTENT_SCORE=60
COOLDOWN_DAYS=90
DAILY_SEND_LIMIT=10
AUTONOMY_STAGE=1
MAX_JOB_ATTEMPTS=4

# ─── Markets ────────────────────────────────────────────────────────────────
# Every country is a target for discovery and outreach except these
EXCLUDED_COUNTRIES=PK,IN,BD
ALL_COUNTRIES_OUTREACH_ENABLED=true
# Social posts older than this (or without a timestamp) are dropped
SOCIAL_MAX_POST_AGE_HOURS=8

# ─── LLM fallback (scoring and drafting when Gemini's daily cap is used up) ─
LLM_FALLBACK_PROVIDER=groq
GROQ_API_KEY=
# Empty = the built-in default free model
GROQ_MODEL=
GROQ_DAILY_REQUEST_CAP=900

# ─── Search router (tried in this order; each provider within its own cap) ─
SEARCH_PROVIDER_ORDER=serper,serpapi,scrapingdog,searlo,tavily,exa
SERPER_API_KEY_FALLBACK=
SERPAPI_API_KEY=
SERPAPI_MONTHLY_CAP=90
SCRAPINGDOG_API_KEY=
SCRAPINGDOG_MONTHLY_CAP=900
SEARLO_API_KEY=
SEARLO_MONTHLY_CAP=100
TAVILY_API_KEY=
TAVILY_MONTHLY_CAP=900
EXA_MONTHLY_CAP=500

# ─── Open data and registries (no keys) ────────────────────────────────────
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_URLS=
OVERPASS_MAX_REQUESTS_PER_MINUTE=2
GEOFABRIK_BASE_URL=https://download.geofabrik.de
GEOFABRIK_ENABLED=false
FR_RECHERCHE_ENTREPRISES_URL=https://recherche-entreprises.api.gouv.fr
FR_RECHERCHE_MAX_RPS=5
NO_BRREG_API_URL=https://data.brreg.no/enhetsregisteret/api
OSM_ATTRIBUTION=© OpenStreetMap contributors (ODbL)

# ─── Social providers (all on; per platform, the next provider takes over) ─
# LinkedIn only through the providers' LinkedIn endpoints. SOCIAL_PROVIDER_DAILY_CAP counts
# provider credits per provider per day.
SOCIAL_SOURCES_ENABLED=true
SOCIAL_PLATFORMS=instagram,tiktok,facebook,x,reddit,youtube,linkedin,pinterest,threads,twitch,github,linktree
ENSEMBLEDATA_API_TOKEN=
SCRAPECREATORS_API_KEY=
SOCIALCRAWL_API_KEY=
HIKERAPI_BASE_URL=https://api.instagrapi.com
HIKERAPI_ACCESS_KEY=
SOCIAL_PROVIDER_DAILY_CAP=50

# ─── Outreach from Gmail ────────────────────────────────────────────────────
# gmail = "Open in Gmail" compose link, or a Gmail draft/send when GMAIL_APP_PASSWORD is set
OUTREACH_EMAIL_MODE=gmail
GMAIL_SENDER=
GMAIL_APP_PASSWORD=
# draft (IMAP into Drafts; you press Send) | send (SMTP)
GMAIL_DELIVERY=draft
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_DAILY_SEND_CAP=400
# Optional: Google Cloud OAuth client (Gmail API drafts, scope gmail.compose)
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8000/api/gmail/oauth/callback
REPLY_TO_EMAIL=
ZEROBOUNCE_MONTHLY_CAP=90
