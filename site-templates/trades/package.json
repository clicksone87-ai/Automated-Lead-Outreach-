{
  "name": "site-template-trades",
  "version": "1.0.0",
  "private": true,
  "description": "Website preview template for local trades / home services. Compiled once per template version; each preview is rendered to static HTML from content.json by render/cli.cjs.",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "build:render": "tsc -p tsconfig.render.json && node render/build-css.mjs",
    "render": "node render/cli.cjs"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "5.7.2"
  }
}
